          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (!data.exists() || data.val() === auth.uid)",
          ".validate": "$cle.length >= 3 && $cle.length <= 20 && $cle === $cle.toLowerCase() && newData.isString() && newData.val() === auth.uid"
        }
      },
  
      // Données d'un compte : lecture et écriture par son seul uid ; pseudo et avatar lisibles par tout connecté.
      "joueurs": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'",
          "pseudo":   { ".read": "auth != null", ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20" },
          "avatarId": { ".read": "auth != null", ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_-]{1,40}$/)" },
          "avatarImg": { ".read": "auth != null", ".validate": "newData.isString() && newData.val().length <= 30000 && newData.val().matches(/^data:image\\/(jpeg|webp);base64,[A-Za-z0-9+\\/=]+$/)" },
          "cree":     { ".validate": "newData.isNumber()" },
          // Résumé public des parties (victoires v sur n parties), lisible par tout connecté.
          "stats":    { ".read": "auth != null", ".validate": "newData.hasChildren(['v', 'n']) && newData.child('v').isNumber() && newData.child('n').isNumber() && newData.child('v').val() >= 0 && newData.child('v').val() <= newData.child('n').val()", "v": { ".validate": "newData.isNumber()" }, "n": { ".validate": "newData.isNumber()" }, "$autre": { ".validate": false } },
          // 12 decks au plus : emplacements 0 à 11. Le total 24 à 30 est vérifié par le site
          // (un deck en cours de construction peut être plus petit).
          "decks": {
            "$i": {
              ".validate": "$i.matches(/^([0-9]|1[01])$/) && newData.hasChildren(['id', 'nom'])",
