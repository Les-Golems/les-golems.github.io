          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
          ".validate": "newData.hasChildren(['v', 'n']) && newData.child('v').isNumber() && newData.child('n').isNumber() && newData.child('v').val() >= 0 && newData.child('v').val() <= newData.child('n').val() && (data.exists() ? (data.exists() ? (newData.child('n').val() >= data.child('n').val() && newData.child('n').val() <= data.child('n').val() + 50 && newData.child('v').val() >= data.child('v').val() && newData.child('v').val() - data.child('v').val() <= newData.child('n').val() - data.child('n').val()) : newData.child('n').val() <= 50) : (root.child('classement').child($uid).exists() ? (newData.child('n').val() >= root.child('classement').child($uid).child('n').val() && newData.child('n').val() <= root.child('classement').child($uid).child('n').val() + 50 && newData.child('v').val() >= root.child('classement').child($uid).child('v').val() && newData.child('v').val() - root.child('classement').child($uid).child('v').val() <= newData.child('n').val() - root.child('classement').child($uid).child('n').val()) : newData.child('n').val() <= 50))",
          "v": {
            ".validate": "newData.isNumber()"
          },
          "n": {
            ".validate": "newData.isNumber()"
          },
          "$autre": {
            ".validate": false
          }
        },
        "decks": {
          "$i": {
            ".validate": "$i.matches(/^([0-9]|1[01])$/) && newData.hasChildren(['id', 'nom'])",
            "id": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{1,16}$/)"
            },
            "nom": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "v": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9a-z.]{1,10}$/)"
            },
            "cartes": {
