              ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && !data.exists() && newData.child('a').val() === auth.uid && (!root.child('essai').child('salons').child($code).child('engages').exists() || root.child('essai').child('salons').child($code).child('engages').hasChild(auth.uid))",
              ".validate": "newData.hasChildren(['a', 's', 'g', 'n', 'c'])",
              "a": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "s": { ".validate": "newData.isString() && newData.val().length <= 16" },
              "g": { ".validate": "newData.isNumber()" },
              "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 2000" },
              "c": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "$autre": { ".validate": false }
            }
          },

          // Chat du salon : comme en haut, sous essai/.
          "chat": {
            "$m": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && !data.exists() && newData.child('a').val() === auth.uid && (root.child('essai').child('salons').child($code).child('joueurs').hasChild(auth.uid) || root.child('essai').child('salons').child($code).child('engages').hasChild(auth.uid))",
              ".validate": "newData.hasChildren(['a', 'p', 't', 'm'])",
              "a": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "p": { ".validate": "newData.isString() && newData.val() === root.child('essai').child('joueurs').child(auth.uid).child('pseudo').val()" },
              "t": { ".validate": "newData.val() === now" },
              "m": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
              "$autre": { ".validate": false }
            }
          },

          // Rien d'autre dans un salon.
          "$autre": { ".validate": false }
        }
      }
    }
  }
}
