                ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[a-zA-Z0-9_\\/.-]+$/)"
              },
              "$autre": {
                ".validate": false
              }
            }
          }
        }
      },
      "guides": {
        ".read": true,
        "$g": {
          ".validate": "$g.matches(/^[a-z0-9-]{1,40}$/)",
          "votes": {
            "$uid": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && auth.uid === $uid",
              ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === -1)"
            }
          },
          "$autre": {
            ".validate": false
          }
        }
      },
      "enligne": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === now"
        }
      }
    }
  }
}
