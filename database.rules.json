// Règles de la Realtime Database « les-golems » (à coller dans la console, onglet Règles).
// essai/ = site d'essai (les-golems.github.io/essai) : mêmes règles, données séparées (comptes Auth partagés).
{
  "rules": {
    ".read": false,
    ".write": false,
    "pseudos": {
      "$cle": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (!data.exists() || data.val() === auth.uid) && (newData.exists() || !newData.parent().parent().child('joueurs').child(auth.uid).child('pseudo').exists() || newData.parent().parent().child('joueurs').child(auth.uid).child('pseudo').val().toLowerCase() !== $cle)",
        ".validate": "$cle.length >= 3 && $cle.length <= 20 && $cle === $cle.toLowerCase() && newData.isString() && newData.val() === auth.uid"
      }
    },
    "joueurs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'",
        "pseudo": {
          ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20 && newData.parent().parent().parent().child('pseudos').child(newData.val().toLowerCase()).val() === $uid"
