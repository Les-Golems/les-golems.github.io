              "nom": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
              "t":   { ".validate": "newData.isNumber()" },
              // Carte (001, 001e...) : 1 à 3 exemplaires, base et évolution à part.
              "cartes": {
                "$c": { ".validate": "$c.matches(/^[0-9]{3}e?$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" }
              },
              "$autre": { ".validate": false }
            }
          },
          // Historique : une entrée par partie (clé graine-début), d = date, x = détail en JSON.
          // Le site garde les 50 dernières et efface les plus anciennes.
          "historique": {
            ".indexOn": ["d"],
            "$h": {
              ".validate": "$h.matches(/^-?[0-9]{1,12}-[0-9]{10,14}$/) && newData.hasChildren(['d', 'x'])",
              "d": { ".validate": "newData.isNumber()" },
              "x": { ".validate": "newData.isString() && newData.val().length <= 12000" },
              "$autre": { ".validate": false }
            }
          },
          // Témoin d'import des données locales (proposé une seule fois).
          "importe": { ".validate": "newData.isNumber()" },
          "$autre": { ".validate": false }
        }
      },
  
      // Accueil : qui est connecté, et départs volontaires (quitte). Comptes seulement.
      "hall": {
        ".read": "auth != null",
        "$uid": {
          // Chacun n'écrit que sa propre présence, avec son vrai pseudo.
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'",
          ".validate": "newData.hasChild('t')",
          "pseudo": { ".validate": "newData.isString() && newData.val() === root.child('essai').child('joueurs').child($uid).child('pseudo').val()" },
          "salon":  { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{3,8}$/)" },
          "quitte": { ".validate": "newData.isNumber()" },
          "t":      { ".validate": "newData.val() === now" },
          // Aucun autre champ.
          "$autre": { ".validate": false }
        }
      },
  
      // Dernière activité d'un salon : activite/{code} = heure serveur, posée par un joueur présent.
      // Lecture seulement par la requête du nettoyage (tri par valeur, 50 au plus) ; effacement seulement si plus de 7 jours.
      "activite": {
        ".read": "auth != null && query.orderByValue == true && query.limitToFirst <= 50",
        ".indexOn": ".value",
        "$code": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((newData.exists() && newData.parent().parent().child('essai').child('salons').child($code).child('joueurs').hasChild(auth.uid)) || (!newData.exists() && data.val() < now - 604800000))",
          ".validate": "$code.matches(/^[a-z0-9]{3,8}$/) && newData.val() === now"
        }
      },

      // Salons publics en attente d'un adversaire : annonce posée par le créateur présent dans son salon (u = son uid),
      // retirée par lui ou par un joueur présent dans le salon ; effacée à sa déconnexion.
      "annonces": {
        ".read": "auth != null",
        "$code": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((newData.exists() && newData.child('u').val() === auth.uid && (!data.exists() || data.child('u').val() === auth.uid) && root.child('essai').child('salons').child($code).child('joueurs').hasChild(auth.uid)) || (!newData.exists() && (data.child('u').val() === auth.uid || root.child('essai').child('salons').child($code).child('joueurs').hasChild(auth.uid))))",
          ".validate": "$code.matches(/^[a-z0-9]{3,8}$/) && newData.hasChildren(['u', 'p', 't'])",
          "u": { ".validate": "newData.val() === auth.uid" },
          "p": { ".validate": "newData.isString() && newData.val() === root.child('essai').child('joueurs').child(auth.uid).child('pseudo').val()" },
          "a": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_-]{1,40}$/)" },
          "d": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "e": { ".validate": "newData.isString() && newData.val().matches(/^[a-z,]{0,60}$/)" },
          "t": { ".validate": "newData.val() === now" },
          "$autre": { ".validate": false }
        }
      },
      "salons": {
        // Identifiant de salon court : 3 à 8 lettres minuscules ou chiffres.
        "$code": {
          ".validate": "$code.matches(/^[a-z0-9]{3,8}$/)",
          // Effacement du salon entier (joueurs, coups, chat) seulement si sa dernière activité date de plus de 7 jours.
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && !newData.exists() && root.child('essai').child('activite').child($code).val() < now - 604800000",
          // Lecture d'un salon (joueurs et coups) pour tout joueur connecté.
          ".read": "auth != null",
  
          // Verrou de partie : les deux uid engagés, posé au démarrage par un joueur présent.
          // Ensuite seuls ces deux comptes peuvent écrire dans le salon (un tiers voit « salon complet »).
          // Un engagé peut l'effacer (adversaire parti), ce qui rouvre le salon.
          "engages": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((!data.exists() && newData.hasChild(auth.uid)) || (data.hasChild(auth.uid) && !newData.exists()))",
            "$u": { ".validate": "newData.val() === true && root.child('essai').child('salons').child($code).child('joueurs').child($u).exists()" }
          },
  
          "joueurs": {
            "$uid": {
              // Chaque compte n'écrit que sous son propre uid (le jeu en ligne exige un compte),
              // et seulement s'il est engagé quand une partie a commencé.
              ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password' && (!newData.exists() || !root.child('essai').child('salons').child($code).child('engages').exists() || root.child('essai').child('salons').child($code).child('engages').hasChild($uid))",
              ".validate": "newData.hasChild('t')",
              "pseudo":  { ".validate": "newData.isString() && newData.val() === root.child('essai').child('joueurs').child($uid).child('pseudo').val()" },
              "sid":     { ".validate": "newData.isString() && newData.val().length <= 16" },
              "adv":     { ".validate": "newData.isString() && newData.val().length <= 16" },
              "arrivee": { ".validate": "newData.isNumber()" },
              "graine":  { ".validate": "newData.isNumber()" },
              "jg":      { ".validate": "newData.isNumber()" },
              "veut":    { ".validate": "newData.isNumber()" },
              "quitte":  { ".validate": "newData.isNumber()" },
              "pret":    { ".validate": "newData.isBoolean()" },
              // Deck joué, texte compact (carte puis nombre : 0013002e2...) ; absent = paquet de test.
              "deck":    { ".validate": "newData.isString() && newData.val().length <= 300 && newData.val().matches(/^([0-9]{3}e?[1-3])+$/)" },
              "t":       { ".validate": "newData.val() === now" },
